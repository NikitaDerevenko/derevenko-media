# Адрес сайта без слеша в конце — обязателен для сборки.
# От него строятся canonical, hreflang, sitemap.xml, robots.txt, Open Graph и JSON-LD.
NEXT_PUBLIC_SITE_URL=https://ваш-домен.ru

# Адрес функции приёма заявок в Яндекс Облаке (cloud/lead), например https://functions.yandexcloud.net/d4e...
# Пусто — формы предлагают написать в Telegram.
NEXT_PUBLIC_LEAD_URL=

# Яндекс Метрика: номер счётчика. Подключается только после согласия на cookie.
NEXT_PUBLIC_YM_ID=

# Токен бота и id чата здесь НЕ задаются: сайт — статичные файлы, секреты живут только
# в переменных функции в Яндекс Облаке (см. cloud/lead/README.md).
