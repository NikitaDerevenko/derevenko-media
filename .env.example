# Адрес сайта без слеша в конце — обязателен для production-сборки.
# От него строятся canonical, hreflang, sitemap.xml, robots.txt, Open Graph и JSON-LD.
NEXT_PUBLIC_SITE_URL=https://ваш-домен.ru

# Яндекс Метрика: номер счётчика. Подключается только после согласия на cookie.
NEXT_PUBLIC_YM_ID=

# Заявки в Telegram: токен бота от @BotFather и id чата, куда слать заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Файл на сервере, куда каждая заявка дописывается строкой JSON до отправки в Telegram.
# Нужен для 152-ФЗ: первичная запись данных граждан РФ — в базе на территории РФ (хостинг в России).
LEADS_STORE_FILE=/var/data/leads.jsonl
